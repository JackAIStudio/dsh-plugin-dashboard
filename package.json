{
  "name": "dsh-plugin-dashboard",
  "version": "0.1.2",
  "private": true,
  "description": "JackDSH 自研插件与版本大盘：展示 DSH 官方底座与自研插件版本矩阵，支持免命令行无感热开关与一键诊断复制。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "license": "MIT"
}
